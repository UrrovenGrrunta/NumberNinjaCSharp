diff --git a/NumberNinjaCSharp/Game/ChallengeTimer.cs b/NumberNinjaCSharp/Game/ChallengeTimer.cs
new file mode 100644
index 0000000..0c4f890
--- /dev/null
+++ b/NumberNinjaCSharp/Game/ChallengeTimer.cs
@@ -0,0 +1,33 @@
+using System;
+
+public class ChallengeTimer
+{
+    private const int StartTime = 300;
+    public int TimeRemaining {get; private set;} = StartTime;
+
+    public int Penalize()
+    {
+        if (TimeRemaining > 10)
+        {
+            TimeRemaining -= 10;
+        }
+        else
+        {
+            TimeRemaining = 0;
+        }
+        return TimeRemaining;
+    }
+    public int Tick()
+    {
+        if (TimeRemaining > 0)
+        {
+            TimeRemaining--;
+        }
+        return TimeRemaining;
+    }
+    public int Reset()
+    {
+        TimeRemaining = StartTime;
+        return TimeRemaining; 
+    }
+}
